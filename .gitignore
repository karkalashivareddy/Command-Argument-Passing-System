# Build artifacts
/build/
caps
caps-asan

# Object and dependency files
*.o
*.d

# Core dumps and crash artifacts
core
core.*
vgcore.*

# Editor / IDE metadata
.vscode/
.idea/
*.swp
*~

# OS noise
.DS_Store
Thumbs.db

# Web frontend artifacts
web/frontend/node_modules/
web/frontend/dist/
web/frontend/.vite/
web/backend/node_modules/
web/backend/dist/
web/backend/*.db
web/backend/*.db-*
data/
*.log

# The screenshots under docs/screenshots/ are deliberate documentation
# artifacts and are tracked. Capture output written outside that directory is
# not, so a stray run cannot commit a screenful of noise.
web/frontend/docs/
*.env.local
*.env.*.local

# Scratch files left in the repository root by ad-hoc runs. None is source, and
# none is referenced by the engine, the gateway, or any test. `output.txt` in
# particular collides by name with the workspace file the `du` catalog example
# uses, so ignoring the name is safe precisely because nothing at the root is.
/output.txt
/output.txtx
/shape.cjs

# A personal slide deck, not part of the source tree. Tracked here rather than
# deleted so it stays on disk without becoming a repository artifact.
*.pptx
